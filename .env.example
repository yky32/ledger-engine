# Copy to .env and adjust. Prefer env overrides over editing application.yml.
# Pattern: ${ENV_VAR:default} in application.yml ( practice).

# --- Server ---
SERVER_PORT=8080
CONTEXT_PATH=/
MICROSERVICE_TIME_ZONE=UTC
SYSTEM_INVOKER=LEDGER

# --- Database (Docker test-db on host 5433) ---
DB_URL=jdbc:postgresql://localhost:5433/ledger-engine
DB_USERNAME=postgres
DB_PASSWORD=postgres
# JPA_DDL_AUTO=update|validate|none|create
JPA_DDL_AUTO=update
# LIQUIBASE_ENABLED=false until real changesets exist
LIQUIBASE_ENABLED=false

# --- Kafka (optional) ---
KAFKA_URL=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# LEDGER_KAFKA_ENABLED=true
# LEDGER_KAFKA_TOPIC=ledger.transaction.events
# LEDGER_MOVEMENT_KAFKA_ENABLED=false

# --- Simulator (docker compose) ---
SIM_MODE=webhook
SIM_ONBOARD_WALLETS=true
SIM_LEDGER_BASE_URL=http://app:8080
SIM_WEBHOOK_URL=http://app:8080/integrations/webhooks/transactions
SIM_KAFKA_BOOTSTRAP=kafka:9092
SIM_KAFKA_TOPIC=ledger.transaction.events
SIM_INTERVAL_SECONDS=2
SIM_TRANSACTION_COUNT=20
SIM_CURRENCY=LP
SIM_AMOUNT_MIN=10
SIM_AMOUNT_MAX=500
SIM_EVENT_TYPE=PURCHASE
SIM_USER_ID_PREFIX=UAF-
SIM_USER_COUNT=5
SIM_BATCH_SIZE=500
SIM_EXTERNAL_TYPE=uafinance
SIM_WAIT_FOR_HEALTH=true
