# Copy to .env and adjust. Prefer env overrides over editing application.yml.
# Pattern: ${ENV_VAR:default} in application.yml

# --- Server ---
SERVER_PORT=8080
CONTEXT_PATH=/
MICROSERVICE_TIME_ZONE=UTC
SYSTEM_INVOKER=LEDGER

# --- Database (docker compose postgres — host port 5433) ---
# Matches application.yml defaults and docker-compose.yml postgres service.
POSTGRES_HOST_PORT=5433
POSTGRES_DB=ledger-engine
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_URL=jdbc:postgresql://localhost:5433/ledger-engine
DB_USERNAME=postgres
DB_PASSWORD=postgres
# JPA_DDL_AUTO=update|validate|none|create
# First boot on empty DB: create (or update). failed_transaction_ingest via JPA.
JPA_DDL_AUTO=update
LIQUIBASE_ENABLED=false

# --- Kafka (optional) ---
KAFKA_URL=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# LEDGER_KAFKA_ENABLED=true
# LEDGER_KAFKA_TOPIC=ledger.transaction.events

# --- Integration ---
LEDGER_INTEGRATION_ENABLED=true
# Digestion rules: create via POST /digestion-rules (no YAML seed)

# --- Simulator (docker compose --profile simulator) ---
SIM_MODE=webhook
SIM_ONBOARD_WALLETS=true
SIM_LEDGER_BASE_URL=http://app:8080
SIM_WEBHOOK_URL=http://app:8080/integrations/webhooks/transactions
SIM_KAFKA_BOOTSTRAP=kafka:9092
SIM_KAFKA_TOPIC=ledger.transaction.events
SIM_INTERVAL_SECONDS=2
SIM_TRANSACTION_COUNT=20
SIM_CURRENCY=HKD
SIM_AMOUNT_MIN=10
SIM_AMOUNT_MAX=500
SIM_EVENT_TYPE=PURCHASE
SIM_USER_ID_PREFIX=01A
SIM_USER_COUNT=5
SIM_BATCH_SIZE=500
SIM_ASSOCIATED_FROM=CRM
SIM_WAIT_FOR_HEALTH=true
