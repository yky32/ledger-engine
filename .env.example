# Copy to .env and adjust for local docker compose runs.
# docker compose --env-file .env up

# --- Simulator ---
# Phase 1 backfill (UAfinance ~70K 1:1 wallets):
#   SIM_MODE=backfill SIM_USER_COUNT=70000 SIM_USER_ID_PREFIX=UAF-
# Phase 2 events:
#   SIM_MODE=webhook SIM_ONBOARD_WALLETS=false
SIM_MODE=webhook
SIM_ONBOARD_WALLETS=true
SIM_LEDGER_BASE_URL=http://app:8080
SIM_WEBHOOK_URL=http://app:8080/integrations/webhooks/transactions
SIM_KAFKA_BOOTSTRAP=kafka:9092
SIM_KAFKA_TOPIC=ledger.transaction.events

# Timing & volume (events)
SIM_INTERVAL_SECONDS=2
SIM_TRANSACTION_COUNT=20
# 0 = run until container stops

# Event shape
SIM_CURRENCY=LP
SIM_AMOUNT_MIN=10
SIM_AMOUNT_MAX=500
SIM_EVENT_TYPE=PURCHASE

# Customer set (synthetic or file)
SIM_USER_ID_PREFIX=UAF-
SIM_USER_COUNT=5
# SIM_CUSTOMER_FILE=/data/customers.csv
SIM_BATCH_SIZE=500
SIM_BATCH_PAUSE_SECONDS=0.05
SIM_EXTERNAL_TYPE=uafinance
SIM_SMOKE_EVENTS_AFTER_BACKFILL=0
SIM_WAIT_FOR_HEALTH=true

# --- Ledger Engine (app service) ---
LEDGER_KAFKA_ENABLED=true
LEDGER_KAFKA_TOPIC=ledger.transaction.events
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

