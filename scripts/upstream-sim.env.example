# Optional config for ./scripts/upstream-sim.sh
# cp scripts/upstream-sim.env.example scripts/upstream-sim.env

# BASE_URL=http://localhost:8080
# PORT=8080
# CUST=01A12345678

# Base purchase amount (or set min/max for random variation)
# AMOUNT=200
# AMOUNT_MIN=50
# AMOUNT_MAX=800
# CURRENCY=HKD

# Filter-matrix counts (suite / e2e)
COUNT_PURCHASE_OK=5
COUNT_PURCHASE_USD=2
COUNT_PURCHASE_JPY=2
COUNT_TOO_SMALL=1
COUNT_TOO_OLD=1
COUNT_SIGNUP=1
COUNT_REDEEM=1
COUNT_DUPLICATE=1

# SERVER_LOG=target/upstream-sim-server.log
